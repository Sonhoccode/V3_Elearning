DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-backend-app.fly.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_PORT=8080

REDIS_URL=redis://default:password@your-redis-host:6379/0

USER_FE_PORT=5173
ADMIN_FE_PORT=5174
FRONTEND_URL=https://your-user-app.fly.dev
BACKEND_URL=https://your-backend-app.fly.dev
CORS_ALLOWED_ORIGINS=https://your-user-app.fly.dev,https://your-admin-app.fly.dev
COOKIE_SECURE=1
COOKIE_SAMESITE=None
SECURE_SSL_REDIRECT=1

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_BUCKET=lesson-img
SUPABASE_STORAGE_BUCKET=internal-docs

TAVILY_API_KEY=
HF_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
